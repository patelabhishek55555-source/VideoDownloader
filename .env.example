# ─────────────────────────────────────────────────────────────────────────────
# Video Downloader — environment variables
# Every variable is OPTIONAL. The app boots with safe defaults and degrades
# gracefully; variables below only unlock additional capability.
# Never commit a filled-in copy of this file.
# ─────────────────────────────────────────────────────────────────────────────

# Public origin of the deployed site. Used for canonical URLs, Open Graph tags
# and the sitemap. Defaults to VERCEL_PROJECT_PRODUCTION_URL / localhost:3000.
NEXT_PUBLIC_SITE_URL=

# ── Downloader provider (the actual media resolver) ─────────────────────────
# A remote resolver service that turns a public video page URL into direct
# media URLs. Any HTTP service that implements the documented contract works:
# a self-hosted yt-dlp wrapper, or a commercial resolver API.
#
#   Request:  POST {DOWNLOAD_PROVIDER_BASE_URL}   body: { "url": "<page url>" }
#             (GET with ?url= is also supported when DOWNLOAD_PROVIDER_METHOD=GET)
#   Response: {
#     "title": "…", "thumbnail": "https://…", "duration": 34,
#     "formats": [ { "quality": "1080p", "ext": "mp4", "url": "https://…", "size": 12345678 } ]
#   }
#
# Without this, platforms that cannot be resolved natively (Instagram, TikTok,
# Facebook, Pinterest, X) report "Downloader service is not configured."
# Direct media links, Reddit and generic web pages still work with no setup.
DOWNLOAD_PROVIDER_BASE_URL=
DOWNLOAD_PROVIDER_API_KEY=
# Header the API key is sent in (default: Authorization, sent as "Bearer <key>").
DOWNLOAD_PROVIDER_HEADER_NAME=
DOWNLOAD_PROVIDER_METHOD=POST
DOWNLOAD_PROVIDER_TIMEOUT_MS=20000

# ── Signed URL tokens ───────────────────────────────────────────────────────
# HMAC secret used to sign the direct media URLs the resolver returns, so the
# download/ZIP endpoints can prove a URL was actually resolved by this service
# instead of proxying whatever a caller asks for.
# REQUIRED IN PRODUCTION. If unset, an ephemeral per-instance secret is used and
# signatures will not validate across serverless instances.
TOKEN_SECRET=
TOKEN_TTL_SECONDS=3600

# ── Job store (bulk download jobs) ─────────────────────────────────────────
# Upstash Redis (REST) makes bulk jobs survive across serverless instances.
# Leave both empty to use the in-process store (local dev / single instance).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
JOB_TTL_SECONDS=1800

# ── Temporary object storage (optional, S3-compatible) ─────────────────────
# Enables POST /api/zip/store, which builds a ZIP into object storage and
# returns a short-lived signed URL instead of streaming through the function.
# Recommended for large bulk jobs on serverless runtimes.
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_REGION=
OBJECT_STORE_BUCKET=
OBJECT_STORE_ACCESS_KEY=
OBJECT_STORE_SECRET_KEY=
OBJECT_STORE_PREFIX=video-downloader/tmp/
OBJECT_STORE_TTL_SECONDS=900

# ── Abuse prevention ────────────────────────────────────────────────────────
# Optional extra host allowlist for the download/ZIP proxy endpoints, on top of
# signed tokens. Comma separated suffixes, or the literal `default` for the
# built-in list of known media CDN suffixes. Empty (default) = any public host
# a resolver returned.
MEDIA_HOST_ALLOWLIST=
RATE_LIMIT_MAX=40
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_PER_DAY=400
MAX_BULK_URLS=25

# ── Processing limits ───────────────────────────────────────────────────────
# Simultaneous media resolutions per job (server side).
PROCESS_CONCURRENCY=3
# How long a single job invocation may keep processing before returning a
# partial snapshot the client continues with the next request.
JOB_PROCESS_BUDGET_MS=20000
# Per-file and per-ZIP caps (bytes).
MAX_FILE_SIZE_BYTES=524288000
MAX_ZIP_SIZE_BYTES=2147483648
MAX_ZIP_ENTRIES=100
# Page-scrape response cap for the generic web-page provider (bytes).
MAX_PAGE_BYTES=2097152
DEFAULT_FETCH_TIMEOUT_MS=15000

# ── Analytics (optional, privacy-preserving) ───────────────────────────────
# Plausible-style data domain. Leave empty to disable all analytics.
NEXT_PUBLIC_ANALYTICS_SRC=
